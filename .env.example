# 主机侧部署路径
ZERO_NVR_DATA_PATH=./data/zero-nvr
ZERO_NVR_CACHE_PATH=./data/cache
ZERO_NVR_RECORDINGS_PATH=./data/recordings

# 播放缓存容量/TTL 属于产品运行时设置，请在
# 系统 > 常规 > 运行时调优 中管理。仍支持环境变量覆盖作为启动默认值，
# 但这些运行时参数不会写入本部署文件。

# 受保护文件启动约定：
# 将密钥文件存放在主机的 ZERO_NVR_DATA_PATH/bootstrap-secrets 下，
# 并将 *_FILE 指向容器内的 /var/lib/zero-nvr/bootstrap-secrets/<name>。
# 当主密钥的直接值和文件值都为空时，./deploy.sh 会自动生成。
# 如使用受保护文件方式，请保持 ZERO_NVR_SECRET_KEY 为空，并让
# ZERO_NVR_SECRET_KEY_FILE 指向 zero-nvr 容器内可读取的文件。
ZERO_NVR_SECRET_KEY=
ZERO_NVR_SECRET_KEY_FILE=
# 密钥轮换期间，在这里以 JSON 数组保留旧的可读取密钥，直到
# ./deploy.sh secret rotate 完成且轮换后的备份已验证。
ZERO_NVR_SECRET_KEY_PREVIOUS=[]
ZERO_NVR_ZLM_API_SECRET=
ZERO_NVR_ZLM_API_SECRET_FILE=
ZERO_NVR_ZLM_HOOK_SECRET=
ZERO_NVR_ZLM_HOOK_SECRET_FILE=

# Core 镜像
ZERO_NVR_IMAGE=zero-nvr:local
ZERO_NVR_ZLM_IMAGE=zlmediakit/zlmediakit:master

# Core 构建输入。部署脚本优先复用架构匹配的本地基础镜像，仅在缺失时拉取。
# 离线或已预加载镜像的主机可设置 DEPLOY_AUTO_PULL=0，并通过
# docker save/docker load 预先导入这些镜像。
ZERO_NVR_NODE_BASE_IMAGE=node:22-alpine
ZERO_NVR_PYTHON_BASE_IMAGE=python:3.12-slim
DEPLOY_AUTO_PULL=1

# 首次运行 ./deploy.sh install 且 .env 不存在时，交互终端会提示选择构建源；
# 直接回车默认 auto。已有 .env 不会再次提示，CI/无 TTY 环境自动使用 auto。
# 构建依赖源策略：
#   auto     自动探测官方源；不可达或整体偏慢时比较中国大陆镜像并择优（默认）
#   official 强制使用 Debian/PyPI/npm 官方源
#   cn       强制使用清华 Debian/PyPI + npmmirror
#   custom   使用下面四项自定义地址；留空的项回退到对应官方源
# 自动探测只影响 apt/PyPI/npm，不会把 Docker Hub 自动切换到第三方代理。
# 非官方 npm 源安装失败时，镜像构建会自动清理 npm 缓存并回退官方 registry 重试一次。
ZERO_NVR_BUILD_SOURCE_MODE=auto
DEBIAN_MIRROR=
DEBIAN_SECURITY_MIRROR=
PYPI_INDEX_URL=
NPM_REGISTRY=

# custom 示例（中国大陆）：
# DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
# PYPI_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
# NPM_REGISTRY=https://registry.npmmirror.com

# 对外/控制平面端口
ZERO_NVR_API_PORT=8000

# 当前 Core 直接通过 HTTP 暴露 Uvicorn。
# 局域网直连部署保持 false；当 HTTPS 反向代理/Ingress 为浏览器入口
# 终止 TLS 后应改为 true。
ZERO_NVR_SESSION_COOKIE_SECURE=false
# HLS/fMP4 通过 zero-nvr Web/API 的 /zlm 同源代理访问；
# ZLM HTTP/RTSP/RTMP 仅在 Docker 网络内部使用，不发布宿主机端口。
# WebRTC 媒体仍需要单独的 UDP/TCP 端口。NVR 位于 NAT 后时，请保持外部映射端口一致，
# 并将 EXTERN_IP 设置为客户端可访问的地址。
ZERO_NVR_ZLM_WEBRTC_PORT=8001
ZERO_NVR_ZLM_WEBRTC_EXTERN_IP=
# RTSP direct proxy: auto 保留 ZLMediaKit 上游默认；0/1 为显式覆盖。
# 仅在确认 RTSP -> WebRTC 兼容问题时优先尝试 0，不作为全局性能默认。
ZERO_NVR_ZLM_RTSP_DIRECT_PROXY=auto

# 浏览器媒体入口。默认 /zlm 由 zero-nvr Web/API 同源代理到内部 ZLM。
# 只有在自行配置外部 HTTPS 媒体反向代理时，才需要改成完整 http(s) URL。
ZERO_NVR_ZLM_PUBLIC_BASE_URL=/zlm

# 内部组件地址
ZERO_NVR_ZLM_BASE_URL=http://zlmediakit
ZERO_NVR_ZLM_RTSP_BASE_URL=rtsp://zlmediakit:554
ZERO_NVR_ZLM_RTMP_BASE_URL=rtmp://zlmediakit:1935

# 可选 WebRTC TURN。默认局域网 Core 不启用。
# 外部模式：设置 ENABLED=true、URLS 和 SHARED_SECRET 后重启 zero-nvr。
ZERO_NVR_TURN_ENABLED=false
ZERO_NVR_TURN_URLS=
ZERO_NVR_TURN_PUBLIC_HOST=
ZERO_NVR_TURN_PORT=3478
ZERO_NVR_TURN_SHARED_SECRET=
ZERO_NVR_TURN_SHARED_SECRET_FILE=
# TURN 凭据 TTL 在 系统 > 常规 > 运行时调优 中管理。
ZERO_NVR_TURN_REALM=zero-nvr
ZERO_NVR_TURN_EXTERNAL_IP=
ZERO_NVR_TURN_RELAY_MIN_PORT=49160
ZERO_NVR_TURN_RELAY_MAX_PORT=49200

# 浏览器兼容性转码限制属于产品运行时设置，
# 在 系统 > 常规 > 运行时调优 中管理，无需重启容器。

# 默认使用 SQLite。除非使用外部/托管 PostgreSQL，否则保持为空。
ZERO_NVR_DATABASE_URL=
# 显式数据库迁移目标。执行 "./deploy.sh database migrate postgres" 前，
# 可填写外部 PostgreSQL URL；留空则使用托管 PostgreSQL Compose profile。
# 该值不会被打印到终端。
ZERO_NVR_DATABASE_MIGRATION_TARGET_URL=
# 数据库引擎迁移成功后由系统自动写入，用于在回滚宽限期内保留原数据源。
ZERO_NVR_DATABASE_PREVIOUS_URL=

# 有界共享 EVENT_ONLY 预录缓冲区。
# tmpfs 容量/路径属于部署设置，因为该挂载由 Docker 创建。
# 分片/缓冲时长在 系统 > 常规 > 运行时调优 中管理。
ZERO_NVR_PREBUFFER_SIZE=512m
ZERO_NVR_PREBUFFER_DIR=/prebuffer
ZERO_NVR_PREBUFFER_REQUIRE_TMPFS=true

# 容器内产品运行时路径
ZERO_NVR_DATA_DIR=/var/lib/zero-nvr
ZERO_NVR_CACHE_DIR=/var/cache/zero-nvr
ZERO_NVR_RECORDINGS_DIR=/recordings
ZERO_NVR_HUEY_DB_PATH=/var/lib/zero-nvr/huey.db
ZERO_NVR_DEPLOYMENT_CONFIG_DIR=/config/deployment

# Worker 调优
ZERO_NVR_HUEY_WORKERS=2

# 可选托管服务镜像。只有通过 ./deploy.sh feature enable 启用对应
# Compose profile 后，这些服务才会被拉取和启动。
ZERO_NVR_FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:0.18.0
ZERO_NVR_FRIGATE_BIND=127.0.0.1
ZERO_NVR_FRIGATE_PORT=8971
ZERO_NVR_FRIGATE_SHM_SIZE=256mb

ZERO_NVR_MQTT_IMAGE=eclipse-mosquitto:2.1.2-alpine
ZERO_NVR_MQTT_BIND=127.0.0.1
ZERO_NVR_MQTT_PORT=1883
ZERO_NVR_MQTT_USERNAME=zero-nvr
# 为空时由 ./deploy.sh feature enable mqtt 自动生成。
ZERO_NVR_MQTT_PASSWORD=
ZERO_NVR_MQTT_PASSWORD_FILE=

ZERO_NVR_OPENLIST_IMAGE=openlistteam/openlist:v4.2.6
ZERO_NVR_OPENLIST_BIND=127.0.0.1
ZERO_NVR_OPENLIST_PORT=5244

ZERO_NVR_COTURN_IMAGE=coturn/coturn:4.18.0-r0
ZERO_NVR_TURN_BIND=0.0.0.0

ZERO_NVR_POSTGRES_IMAGE=postgres:17.11-alpine3.24
ZERO_NVR_POSTGRES_DB=zero_nvr
ZERO_NVR_POSTGRES_USER=zero_nvr
# 为空时由 ./deploy.sh feature enable postgres 自动生成。
ZERO_NVR_POSTGRES_PASSWORD=
ZERO_NVR_POSTGRES_PASSWORD_FILE=

# 可选 Compose profiles，使用逗号分隔。
# 支持的托管 profile：frigate,mqtt,openlist,postgres,turn
COMPOSE_PROFILES=
