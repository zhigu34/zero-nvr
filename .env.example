# Host-side deployment paths
ZERO_NVR_DATA_PATH=./data/zero-nvr
ZERO_NVR_CACHE_PATH=./data/cache
ZERO_NVR_RECORDINGS_PATH=./data/recordings

# Bounded remote-playback cache inside ZERO_NVR_CACHE_PATH.
ZERO_NVR_PLAYBACK_CACHE_MAX_BYTES=4294967296
ZERO_NVR_PLAYBACK_CACHE_TTL_SECONDS=21600
ZERO_NVR_PLAYBACK_RESTORE_LOCK_TTL_SECONDS=900

# Generated automatically by ./deploy.sh when blank.
ZERO_NVR_SECRET_KEY=
ZERO_NVR_ZLM_API_SECRET=
ZERO_NVR_ZLM_HOOK_SECRET=

# Core images
ZERO_NVR_IMAGE=zero-nvr:local
ZERO_NVR_ZLM_IMAGE=zlmediakit/zlmediakit:master

# Public/control-plane ports
ZERO_NVR_API_PORT=8000

# The current core stack exposes Uvicorn directly over HTTP.
# Keep false for this direct-LAN bootstrap. Set true as soon as an HTTPS
# reverse proxy/ingress terminates TLS for the browser-facing origin.
ZERO_NVR_SESSION_COOKIE_SECURE=false
# HLS/fMP4 media is exposed to LAN clients on this port, but every playback
# URL carries a short-lived zero-nvr signature validated by ZLM on_play.
ZERO_NVR_ZLM_HTTP_BIND=0.0.0.0
ZERO_NVR_ZLM_HTTP_PORT=8080
ZERO_NVR_ZLM_RTSP_BIND=127.0.0.1
ZERO_NVR_ZLM_RTSP_PORT=8554
# WebRTC uses a single UDP/TCP port. If the NVR is behind NAT, keep the
# external mapping on the same port and set EXTERN_IP to the client-visible IP.
ZERO_NVR_ZLM_WEBRTC_PORT=8000
ZERO_NVR_ZLM_WEBRTC_EXTERN_IP=

# Browser-facing ZLM HTTP base. For direct-LAN HTTP access the frontend
# rewrites loopback localhost to the hostname used to open zero-nvr.
# For HTTPS/reverse-proxy deployments, set this to the routed HTTPS media base.
ZERO_NVR_ZLM_PUBLIC_BASE_URL=http://localhost:8080

# Internal component addresses
ZERO_NVR_ZLM_BASE_URL=http://zlmediakit
ZERO_NVR_ZLM_RTSP_BASE_URL=rtsp://zlmediakit:554
ZERO_NVR_ZLM_RTMP_BASE_URL=rtmp://zlmediakit:1935

# Bounded on-demand browser compatibility transcode.
ZERO_NVR_LIVE_TRANSCODE_MAX_DERIVATIVES=2
ZERO_NVR_LIVE_TRANSCODE_IDLE_TTL_SECONDS=20
ZERO_NVR_LIVE_TRANSCODE_LEASE_TTL_SECONDS=30
ZERO_NVR_LIVE_TRANSCODE_STARTUP_TIMEOUT_SECONDS=10
ZERO_NVR_LIVE_TRANSCODE_CPU_THREADS=2
ZERO_NVR_LIVE_TRANSCODE_VIDEO_BITRATE_KBPS=4000

# SQLite is the default. Leave blank unless using external/managed PostgreSQL.
ZERO_NVR_DATABASE_URL=
# Explicit engine migration target. Set this to an external PostgreSQL URL
# before "./deploy.sh database migrate postgres". Leave blank to use the
# managed PostgreSQL Compose profile instead. The value is never printed.
ZERO_NVR_DATABASE_MIGRATION_TARGET_URL=
# Written automatically after a successful database-engine migration so the
# previous source remains available through the rollback grace period.
ZERO_NVR_DATABASE_PREVIOUS_URL=

# Shared bounded EVENT_ONLY prebuffer.
ZERO_NVR_PREBUFFER_SIZE=512m
ZERO_NVR_PREBUFFER_DIR=/prebuffer
ZERO_NVR_PREBUFFER_FRAGMENT_SECONDS=5
ZERO_NVR_PREBUFFER_BUFFER_SECONDS=35
ZERO_NVR_PREBUFFER_REQUIRE_TMPFS=true

# Product runtime paths inside the container.
ZERO_NVR_DATA_DIR=/var/lib/zero-nvr
ZERO_NVR_CACHE_DIR=/var/cache/zero-nvr
ZERO_NVR_RECORDINGS_DIR=/recordings
ZERO_NVR_HUEY_DB_PATH=/var/lib/zero-nvr/huey.db
ZERO_NVR_DEPLOYMENT_CONFIG_DIR=/config/deployment

# Worker tuning
ZERO_NVR_HUEY_WORKERS=2

# Optional managed-service images. These services are not pulled or started
# until their Compose profile is enabled through ./deploy.sh feature enable.
ZERO_NVR_FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:0.18.0
ZERO_NVR_FRIGATE_BIND=127.0.0.1
ZERO_NVR_FRIGATE_PORT=8971
ZERO_NVR_FRIGATE_SHM_SIZE=256mb

ZERO_NVR_MQTT_IMAGE=eclipse-mosquitto:2.1.2-alpine
ZERO_NVR_MQTT_BIND=127.0.0.1
ZERO_NVR_MQTT_PORT=1883
ZERO_NVR_MQTT_USERNAME=zero-nvr
# Generated by ./deploy.sh feature enable mqtt when blank.
ZERO_NVR_MQTT_PASSWORD=

ZERO_NVR_OPENLIST_IMAGE=openlistteam/openlist:v4.2.6
ZERO_NVR_OPENLIST_BIND=127.0.0.1
ZERO_NVR_OPENLIST_PORT=5244

ZERO_NVR_POSTGRES_IMAGE=postgres:17.11-alpine3.24
ZERO_NVR_POSTGRES_DB=zero_nvr
ZERO_NVR_POSTGRES_USER=zero_nvr
# Generated by ./deploy.sh feature enable postgres when blank.
ZERO_NVR_POSTGRES_PASSWORD=

# Optional Compose profiles, comma-separated.
# Supported managed profiles: frigate,mqtt,openlist,postgres
COMPOSE_PROFILES=
