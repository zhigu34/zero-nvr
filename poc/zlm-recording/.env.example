# POC-only credentials. Do not reuse in production.
ZLM_API_SECRET=zero-nvr-poc-secret
ZLM_HOOK_TOKEN=zero-nvr-poc-hook

# ZLM official image follows master; the harness records the actual runtime
# version/commit in evidence.json. Override with a digest/tag when desired.
ZLM_IMAGE=zlmediakit/zlmediakit:master

# Reproducible synthetic RTSP source.
MEDIAMTX_IMAGE=bluenviron/mediamtx:1.21.0-ffmpeg

# Accelerated POC segmentation. Production design target remains ~300s.
POC_SEGMENT_SECONDS=10

# POC-01 uses ordinary MP4. POC-02 sets this to 1.
POC_ZLM_ENABLE_FMP4=0

# Set to 1 to keep containers alive after scripts/run.sh for inspection.
KEEP_RUNNING=0

# EVENT_ONLY rolling tmpfs POC.
POC_PREBUFFER_SEGMENT_SECONDS=5
POC_PRE_ROLL_SECONDS=10
POC_POST_ROLL_SECONDS=10
POC_BUFFER_SECONDS=35
POC_PREBUFFER_TMPFS_BYTES=268435456

# Comparison-only ZLM frame GOP cache size; the primary rolling-tmpfs
# candidate does not depend on this.
POC_ZLM_GOP_CACHE=10

# POC-only remote restore transport.
RCLONE_IMAGE=rclone/rclone:latest
POC_RCLONE_BWLIMIT=200k
